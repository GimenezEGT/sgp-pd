# Copie para .env e troque TODOS os valores fictícios. O .env nunca vai para o Git.
DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria-longa
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost:8443,https://127.0.0.1:8443
DJANGO_SECURE_COOKIES=true

# Banco: papel dono (migrações) e papel da aplicação (execução)
DB_NAME=sgp
DB_OWNER_USER=sgp_owner
DB_OWNER_PASSWORD=troque-senha-dono
DB_USER=sgp_app
DB_PASSWORD=troque-senha-aplicacao
DB_APP_ROLE=sgp_app

# Portas publicadas pelo Nginx (desenvolvimento: 8443/8080; produção: 443/80)
HTTPS_PORT=8443
HTTP_PORT=8080
SGP_CERT_CN=localhost

# Política da TI (valores provisórios, ratificar com a TI)
SESSION_IDLE_TIMEOUT_MINUTES=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
AUDIT_VERIFY_HOUR=2
AUDIT_VERIFY_MINUTE=0

# LDAP — desenvolvimento (contêiner ldap fictício). Na homologação, use o AD:
#   LDAP_SERVER_URI=ldaps://ad.empresa.local
#   LDAP_USER_FILTER=(sAMAccountName=%(user)s)
#   LDAP_GROUP_TYPE=active_directory_nested
#   LDAP_GROUP_FILTER=(objectClass=group)
LDAP_SERVER_URI=ldap://ldap:389
LDAP_START_TLS=false
LDAP_CA_CERT_FILE=
LDAP_BIND_DN=cn=admin,dc=sgp,dc=dev,dc=local
LDAP_BIND_PASSWORD=admin-dev-ficticio
LDAP_USER_SEARCH_BASE=ou=people,dc=sgp,dc=dev,dc=local
LDAP_USER_FILTER=(uid=%(user)s)
LDAP_GROUP_SEARCH_BASE=ou=groups,dc=sgp,dc=dev,dc=local
LDAP_GROUP_FILTER=(objectClass=groupOfNames)
LDAP_GROUP_TYPE=group_of_names
LDAP_PROFILE_GROUPS={"RD_MANAGER": "cn=sgp-gestores,ou=groups,dc=sgp,dc=dev,dc=local", "ANALYST": "cn=sgp-analistas,ou=groups,dc=sgp,dc=dev,dc=local", "QUALITY": "cn=sgp-qualidade,ou=groups,dc=sgp,dc=dev,dc=local"}
LDAP_TIMEOUT_SECONDS=5

LOG_LEVEL=INFO

# Cadastros de apoio (feature 003)
# Padrão do código de lote (expressão regular); provisório até a Qualidade definir o oficial.
LOT_CODE_PATTERN=^[A-Za-z0-9][A-Za-z0-9./-]*$
# Tamanho máximo de cada anexo ou planilha importada, em MB.
FILE_MAX_MB=20
# Tipos aceitos nos anexos de documentos (pdf, png, jpeg).
FILE_DOCUMENT_TYPES=pdf,png,jpeg

# Assinatura eletrônica (feature 005)
SIGNATURE_MAX_FAILURES=3
SIGNATURE_LOCK_MINUTES=15
REVIEW_ALERT_DAYS=5

# Caderno de laboratório (feature 008): dias para assinar a entrada antes de ficar atrasada.
NOTEBOOK_SIGN_DAYS=7

# Painel e notificações (feature 010): SMTP interno, endereço nos e-mails e resumo diário.
EMAIL_HOST=smtp.intranet.local
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=SGP-P&D <sgp-pd@empresa.local>
SITE_URL=https://sgp-pd.intranet.local
NOTIFICATION_DIGEST_HOUR=7
DASHBOARD_CACHE_SECONDS=300
# Cache do painel no Redis (vazio: memória local de cada processo).
CACHE_URL=redis://redis:6379/1

# Geração de documentos (feature 006)
# Certificado da empresa para o selo do PDF oficial (PKCS#12 montado fora do repositório) e senha.
DOCUMENT_SEAL_PKCS12=
DOCUMENT_SEAL_PASSWORD=
# Tempo máximo de cada geração, em segundos.
DOCUMENT_GENERATION_TIME_LIMIT=120
